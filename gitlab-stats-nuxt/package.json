{
  "name": "gitlab-stats-nuxt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write \"app/**/*.{ts,tsx,vue,js,mjs}\" \"server/**/*.{ts,tsx,js,mjs}\" \"types/**/*.ts\" \"*.{json,ts,md}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,vue,js,mjs}\" \"server/**/*.{ts,tsx,js,mjs}\" \"types/**/*.ts\" \"*.{json,ts,md}\""
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "apexcharts": "^5.10.0",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.20",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue3-apexcharts": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}
